---
/**
 * Ornamen geometris bergaris tegas — main-main tapi tetap dewasa.
 *
 *   rings    : dua cincin kawin bertaut
 *   sprig    : ranting zaitun (lambang damai)
 *   sparkle  : bintang empat sudut
 *   star     : bintang garis (asterisk)
 *   arcs     : busur bertingkat bergaya retro
 *   confetti : potongan konfeti geometris
 *   orbit    : lingkaran putus-putus dengan titik
 *
 * Contoh:
 *   <Deco name="rings" class="deco--float deco--rings" style="top:10%;left:5%;width:3rem" />
 * Kelas animasi: deco--float, deco--twinkle, deco--sway, deco--drift, deco--spin, deco--rings
 */
type Name = 'rings' | 'sprig' | 'sparkle' | 'star' | 'arcs' | 'confetti' | 'orbit';

interface Props {
  name: Name;
  class?: string;
  style?: string;
  color?: string;
}

const { name, class: className = '', style = '', color } = Astro.props;
---

{
  name === 'rings' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 64 44" aria-hidden="true">
      <circle class="ring-a" cx="24" cy="24" r="14" fill="none" stroke={color ?? 'var(--accent)'} stroke-width="4" />
      <circle class="ring-b" cx="40" cy="24" r="14" fill="none" stroke={color ?? '#ffffff'} stroke-width="4" />
      <path d="M40 6l3-4 3 4-3 3z" fill={color ?? 'rgb(255 255 255 / 0.8)'} />
    </svg>
  )
}

{
  name === 'sprig' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 120 120" aria-hidden="true">
      <g fill="none" stroke={color ?? '#ffffff'} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 112C32 86 54 60 104 12" />
        <path d="M30 88c-12-2-18-10-18-20 12 2 18 10 18 20Z" />
        <path d="M30 88c2-12 10-18 20-18-2 12-10 18-20 18Z" />
        <path d="M50 66c-12-2-18-10-18-20 12 2 18 10 18 20Z" />
        <path d="M50 66c2-12 10-18 20-18-2 12-10 18-20 18Z" />
        <path d="M70 44c-10-2-16-9-16-18 10 2 16 9 16 18Z" />
        <path d="M70 44c2-10 9-16 18-16-2 10-9 16-18 16Z" />
        <path d="M90 24c-8-2-12-8-12-15 8 2 12 8 12 15Z" />
      </g>
      <circle cx="100" cy="30" r="4" fill={color ?? '#ffffff'} />
    </svg>
  )
}

{
  name === 'sparkle' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 40 40" aria-hidden="true">
      <path d="M20 2c1.6 9.5 5.5 15.4 16 18-10.5 2.6-14.4 8.5-16 18-1.6-9.5-5.5-15.4-16-18 10.5-2.6 14.4-8.5 16-18Z" fill={color ?? 'var(--accent)'} />
    </svg>
  )
}

{
  name === 'star' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 40 40" aria-hidden="true">
      <g stroke={color ?? 'var(--accent)'} stroke-width="3.2" stroke-linecap="round">
        <path d="M20 4v32M6 12l28 16M6 28l28-16" />
      </g>
    </svg>
  )
}

{
  name === 'arcs' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 80 44" aria-hidden="true">
      <g fill="none" stroke-width="5" stroke-linecap="round">
        <path d="M6 40a34 34 0 0 1 68 0" stroke={color ?? 'rgb(255 255 255 / 0.8)'} />
        <path d="M18 40a22 22 0 0 1 44 0" stroke="var(--accent)" />
        <path d="M30 40a10 10 0 0 1 20 0" stroke="var(--accent)" />
      </g>
    </svg>
  )
}

{
  name === 'confetti' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 48 48" aria-hidden="true">
      <rect x="4" y="8" width="12" height="5" rx="1.5" fill="rgb(255 255 255 / 0.8)" transform="rotate(-25 10 10)" />
      <path d="M30 4l7 11H23z" fill="var(--accent)" />
      <circle cx="12" cy="34" r="4.5" fill="none" stroke="var(--accent)" stroke-width="2.5" />
      <rect x="30" y="30" width="11" height="4" rx="1.5" fill={color ?? '#ffffff'} transform="rotate(35 35 32)" />
    </svg>
  )
}

{
  name === 'orbit' && (
    <svg class={`deco ${className}`} style={style} viewBox="0 0 60 60" aria-hidden="true">
      <circle cx="30" cy="30" r="24" fill="none" stroke={color ?? 'rgb(255 255 255 / 0.8)'} stroke-width="2.4" stroke-dasharray="2 7" stroke-linecap="round" />
      <circle cx="30" cy="6" r="4.5" fill="var(--accent)" />
    </svg>
  )
}
