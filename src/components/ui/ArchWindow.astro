---
/**
 * Potret berbentuk lengkung dengan garis tipis putih di sekelilingnya.
 * Dipakai untuk foto mempelai di atas latar foto.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, width = 600, height = 780, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['portrait', className]}>
  <div class="portrait__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</figure>

<style>
  .portrait {
    position: relative;
    margin: 0;
    padding: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: 999px 999px 14px 14px;
  }
  .portrait__frame {
    aspect-ratio: 10 / 13;
    border-radius: 999px 999px 8px 8px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.1);
  }
  .portrait__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
