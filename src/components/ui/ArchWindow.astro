---
/**
 * Potret berbentuk kotak dengan garis tipis putih di sekelilingnya.
 * Dipakai untuk foto mempelai di atas latar foto.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, width = 600, height = 780, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['portrait', className]}>
  <div class="portrait__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</figure>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    margin: 0;
    padding: 0.6rem;
    border-radius: 18px;
    background: linear-gradient(
      165deg,
      rgb(255 255 255 / 0.28),
      rgb(255 255 255 / 0.06) 60%,
      rgb(255 255 255 / 0.14)
    );
    box-shadow:
      0 22px 44px -16px rgb(0 0 0 / 0.5),
      inset 0 1px 0 rgb(255 255 255 / 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Garis luar tipis yang sedikit terpisah dari bingkai utama */
  .portrait::before {
    content: '';
    position: absolute;
    inset: -0.75rem;
    z-index: -1;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 24px;
    pointer-events: none;
  }

  .portrait__frame {
    position: relative;
    aspect-ratio: 10 / 13;
    border-radius: 12px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.7);
  }

  /* Vignette halus di bagian bawah agar foto menyatu dengan latar */
  .portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.2), transparent 38%);
    pointer-events: none;
  }

  .portrait__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
</style>