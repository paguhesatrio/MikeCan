---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<div class="section-head" data-reveal>
  <h2 id={id}>{title}</h2>
  <span class="double-rule double-rule--short" aria-hidden="true"></span>
  {subtitle && <p>{subtitle}</p>}
  <slot />
</div>
