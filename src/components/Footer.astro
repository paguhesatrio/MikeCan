---
import { wedding } from '../data/wedding';
import PhotoSection from './ui/PhotoSection.astro';
---

<footer>
  <PhotoSection id="penutup" photo={wedding.photos.closing} shade="soft" align="end" label="Penutup">
    <div class="footer" data-reveal>
      <p class="footer__message">{wedding.closing.message}</p>
      <p class="footer__thanks">Terima kasih</p>
      <span class="double-rule double-rule--short" aria-hidden="true"></span>
      <p class="footer__sign">{wedding.closing.signature}</p>
      <p class="footer__names">{wedding.couple}</p>
      <p class="footer__families">{wedding.closing.families}</p>
    </div>
  </PhotoSection>
</footer>

<style>
  .footer {
    max-width: 24rem;
    margin-inline: auto;
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .footer__message {
    color: var(--text);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
  }
  .footer__thanks {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.4rem, 11cqi, 3rem);
    line-height: 1;
    color: var(--white);
  }
  .footer .double-rule--short {
    margin-top: 1.25rem;
  }
  .footer__sign {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .footer__names {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 9cqi, 2.3rem);
    color: var(--white);
  }
  .footer__families {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
</style>
