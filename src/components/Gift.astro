---
import { wedding } from '../data/wedding';
import SectionHead from './ui/SectionHead.astro';
import PhotoSection from './ui/PhotoSection.astro';
const { gift } = wedding;
const waUrl = `https://wa.me/${gift.whatsapp}?text=${encodeURIComponent(gift.whatsappMessage)}`;
const groupDigits = (n: string) => n.replace(/(\d{4})(?=\d)/g, '$1 ');
---

<PhotoSection id="kado" photo={wedding.photos.gift} shade="strong" labelledby="kado-title">
  <div class="container">
    <SectionHead id="kado-title" title="Tanda Kasih" subtitle={gift.intro} />

    <div class="accounts">
      {
        gift.accounts.map((a, i) => (
          <article class:list={['account', i % 2 === 1 && 'account--alt']} data-reveal>
            <div class="account__head">
              <p class="account__bank">{a.bank}</p>
              <svg class="account__postmark" viewBox="0 0 60 40" aria-hidden="true">
                <circle cx="20" cy="20" r="16" fill="none" stroke="currentColor" stroke-width="1.6" />
                <circle cx="20" cy="20" r="11" fill="none" stroke="currentColor" stroke-width="1" />
                <path d="M34 12c5-3 9 3 14 0s9 3 12 0M34 20c5-3 9 3 14 0s9 3 12 0M34 28c5-3 9 3 14 0s9 3 12 0" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M20 13l2 5h5l-4 3 1.5 5-4.5-3-4.5 3 1.5-5-4-3h5z" fill="currentColor" />
              </svg>
            </div>
            <p class="account__number" data-number={a.number}>{groupDigits(a.number)}</p>
            <p class="account__holder">a.n. {a.holder}</p>
            <button type="button" class="btn btn--light account__copy" data-copy={a.number} data-bank={a.bank}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="8.5" y="8.5" width="11" height="11" rx="1.5" />
                <path d="M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5" />
              </svg>
              <span data-copy-label>Salin Rekening</span>
            </button>
          </article>
        ))
      }
    </div>

    <div class="gift__confirm" data-reveal>
      <p>Sudah mengirim tanda kasih? Kabari kami, ya, supaya kami bisa berterima kasih secara langsung.</p>
      <a class="btn btn--primary" href={waUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 4.8 5-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
        </svg>
        Konfirmasi via WhatsApp
      </a>
    </div>
  </div>
</PhotoSection>

<style>
  .accounts {
    display: grid;
    gap: 1.5rem;
  }

  /* Kartu rekening berbentuk perangko: sentuhan santai yang tetap jelas dibaca */
  .account {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.2rem;
    padding: 1.7rem 1.6rem 1.6rem;
    color: var(--ink);
    background:
      radial-gradient(circle at 9px 9px, transparent 5.5px, var(--paper) 6px) -9px -9px / 18px 18px round;
    filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.35));
    rotate: -1.2deg;
  }
  .account--alt {
    rotate: 1.2deg;
  }
  .account::before {
    content: '';
    position: absolute;
    inset: 9px;
    z-index: -1;
    border-radius: 4px;
    background: var(--paper);
    border: 1.5px dashed var(--line);
  }
  .account__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .account__bank {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
  }
  .account__postmark {
    width: 3.4rem;
    color: #b9ab93;
    rotate: -10deg;
  }
  .account__number {
    font-size: clamp(1.35rem, 6.2cqi, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }
  .account__holder {
    color: var(--muted);
  }
  .account__copy {
    margin-top: 0.9rem;
    justify-self: start;
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }
  .account__copy.is-copied {
    background: #2c6e52;
  }

  .gift__confirm {
    margin-top: 2.5rem;
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    text-align: center;
  }
  .gift__confirm p {
    color: var(--text-soft);
    max-width: 24rem;
  }
</style>

<script>
  import { showToast } from '../lib/ui';

  async function copyText(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand('copy');
    ta.remove();
    if (!ok) throw new Error('copy failed');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await copyText(btn.dataset.copy!);
        btn.classList.add('is-copied');
        label.textContent = 'Tersalin';
        showToast(`Nomor rekening ${btn.dataset.bank} berhasil disalin`);
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.classList.remove('is-copied');
          label.textContent = 'Salin Rekening';
        }, 2500);
      } catch {
        showToast('Gagal menyalin. Silakan salin nomor rekening secara manual.');
      }
    });
  });
</script>
