---
import { wedding } from '../data/wedding';
import { isSupabaseConfigured } from '../lib/supabase';
import SectionHead from './ui/SectionHead.astro';
import PhotoSection from './ui/PhotoSection.astro';
---

<PhotoSection id="rsvp" photo={wedding.photos.rsvp} shade="medium" labelledby="rsvp-title">
  <div class="container">
    <SectionHead id="rsvp-title" title="Datang, ya!" subtitle="Konfirmasi kehadiran Anda supaya kami bisa menyiapkan tempat terbaik." />

    <div class="glass rsvp" data-reveal>
      <form class="rsvp__form" data-rsvp-form novalidate>
        <div class="field">
          <label class="field__label" for="rsvp-name">Nama</label>
          <input
            class="input"
            id="rsvp-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength="80"
            placeholder="Nama lengkap Anda"
            required
            aria-describedby="rsvp-name-error"
          />
          <p class="field__error" id="rsvp-name-error" hidden></p>
        </div>

        <fieldset class="field choice" aria-describedby="rsvp-attendance-error">
          <legend class="field__label">Apakah Anda akan hadir?</legend>
          <div class="choice__options">
            <label class="choice__option">
              <input type="radio" name="attendance" value="hadir" required />
              <span>Ya, saya akan hadir</span>
            </label>
            <label class="choice__option">
              <input type="radio" name="attendance" value="tidak_hadir" />
              <span>tes, saya tidak dapat hadir, tapi saya mendoakan</span>
            </label>
          </div>
          <p class="field__error" id="rsvp-attendance-error" hidden></p>
        </fieldset>

        <div class="field" data-guest-count hidden>
          <label class="field__label" for="rsvp-count">Jumlah tamu</label>
          <select class="input" id="rsvp-count" name="guest_count">
            <option value="1">1 orang</option>
            <option value="2">2 orang</option>
            <option value="3">3 orang</option>
            <option value="4">4 orang</option>
          </select>
          <p class="field__hint">Termasuk Anda sendiri.</p>
        </div>

        <div class="hp-field" aria-hidden="true">
          <label>Jangan diisi <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p class="form-status" data-status role="status" aria-live="polite" hidden></p>

        <button type="submit" class="btn btn--primary btn--block">Kirim Konfirmasi</button>

        {!isSupabaseConfigured && (
          <p class="field__hint rsvp__config">
            Formulir belum terhubung ke database. Isi PUBLIC_SUPABASE_URL dan PUBLIC_SUPABASE_ANON_KEY.
          </p>
        )}
      </form>

      <div class="rsvp__done" data-rsvp-done hidden tabindex="-1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9.5" />
          <path d="M7.5 12.5l3 3 6-6.5" />
        </svg>
        <h3>Terima kasih, <span data-done-name></span></h3>
        <p data-done-text></p>
        <button type="button" class="btn btn--ghost" data-rsvp-again>Ubah konfirmasi</button>
      </div>
    </div>
  </div>
</PhotoSection>

<style>
  .rsvp__form {
    display: grid;
    gap: 1.35rem;
  }

  .choice {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .choice legend {
    padding: 0;
    margin-bottom: 0.45rem;
  }
  .choice__options {
    display: grid;
    gap: 0.55rem;
  }
  .choice__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.2rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    font-size: 0.97rem;
    line-height: 1.3;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .choice__option:hover {
    border-color: rgb(255 255 255 / 0.5);
  }
  .choice__option input {
    appearance: none;
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0;
    border: 1.5px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .choice__option input::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(0);
    transition: transform 0.15s var(--ease);
  }
  .choice__option:has(input:checked) {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }
  .choice__option input:checked {
    border-color: var(--ink);
  }
  .choice__option input:checked::after {
    transform: scale(1);
  }
  .choice__option input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .rsvp__config {
    text-align: center;
  }

  .rsvp__done {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
    padding-block: 1rem;
    outline: none;
  }
  .rsvp__done svg {
    width: 2.75rem;
    color: var(--accent);
  }
  .rsvp__done h3 {
    font-size: 1.8rem;
  }
  .rsvp__done p {
    color: var(--text-soft);
    max-width: 24rem;
    margin-bottom: 0.75rem;
  }
</style>

<script>
  import { submitRsvp, isSupabaseConfigured, type Attendance } from '../lib/supabase';
  import { cleanText, setStatus } from '../lib/ui';

  const form = document.querySelector<HTMLFormElement>('[data-rsvp-form]');
  const done = document.querySelector<HTMLElement>('[data-rsvp-done]');

  if (form && done) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const nameInput = form.querySelector<HTMLInputElement>('#rsvp-name')!;
    const nameError = form.querySelector<HTMLElement>('#rsvp-name-error')!;
    const attError = form.querySelector<HTMLElement>('#rsvp-attendance-error')!;
    const countWrap = form.querySelector<HTMLElement>('[data-guest-count]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // Isi otomatis nama dari tautan undangan (?to=...)
    const guest = (new URLSearchParams(location.search).get('to') ?? '').trim().slice(0, 80);
    if (guest) nameInput.value = guest;

    const showError = (input: HTMLElement | null, el: HTMLElement, msg: string) => {
      el.textContent = msg;
      el.hidden = !msg;
      input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'attendance') {
        countWrap.hidden = t.value !== 'hadir';
        showError(null, attError, '');
      }
    });
    nameInput.addEventListener('input', () => showError(nameInput, nameError, ''));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus(status, '');

      const data = new FormData(form);
      if (cleanText(data.get('website'))) return; // bot

      const name = cleanText(data.get('name'));
      const attendance = data.get('attendance') as Attendance | null;
      let valid = true;

      if (name.length < 2) {
        showError(nameInput, nameError, 'Mohon isi nama Anda (minimal 2 huruf).');
        valid = false;
      }
      if (!attendance) {
        showError(null, attError, 'Mohon pilih status kehadiran Anda.');
        valid = false;
      }
      if (!valid) {
        (name.length < 2 ? nameInput : form.querySelector<HTMLInputElement>('input[name="attendance"]'))?.focus();
        return;
      }

      if (!isSupabaseConfigured) {
        setStatus(status, 'Formulir belum terhubung ke database. Silakan hubungi mempelai secara langsung.', 'error');
        return;
      }

      const guestCount = attendance === 'hadir' ? Number(data.get('guest_count') ?? 1) : 0;

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.textContent = 'Mengirim…';

      try {
        await submitRsvp({ name, attendance: attendance!, guest_count: guestCount });
        done.querySelector('[data-done-name]')!.textContent = name;
        done.querySelector('[data-done-text]')!.textContent =
          attendance === 'hadir'
            ? `Konfirmasi kehadiran untuk ${guestCount} orang sudah kami terima. Sampai jumpa di hari bahagia kami.`
            : 'Konfirmasi Anda sudah kami terima. Terima kasih atas doa dan dukungan Anda.';
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (err) {
        const msg = err instanceof Error ? err.message : '';
        setStatus(
          status,
          msg.startsWith('Koneksi') || msg.startsWith('Tidak dapat')
            ? msg
            : 'Konfirmasi belum terkirim karena gangguan pada server. Silakan coba lagi beberapa saat lagi.',
          'error',
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        submitBtn.textContent = 'Kirim Konfirmasi';
      }
    });

    done.querySelector('[data-rsvp-again]')?.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      nameInput.focus();
    });
  }
</script>
