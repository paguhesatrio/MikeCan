---
import { wedding1 } from '../data/wedding';
import SectionHead from './ui/SectionHead.astro';

const photos = wedding1.photos.gallery.slice(0, 8);
const background = wedding1.photos.background;

// Rasio bergantian agar tampak seperti mosaik
const ratios = ['3 / 4', '4 / 5', '4 / 3', '3 / 4', '4 / 5', '3 / 4', '4 / 3', '4 / 5'];
---

<section class="gallery" aria-labelledby="galeri-title" style={`--gallery-bg: url('${background}');`}>
  <div class="gallery__bg" aria-hidden="true"></div>

  <div class="container">
    <SectionHead id="galeri-title" title="Galeri" subtitle="Momen kebersamaan kami." />

    <ul class="gallery__grid" data-reveal>
      {
        photos.map((src, i) => (
          <li class="gallery__item">
            <button type="button" class="gallery__btn" data-index={i} aria-label={`Buka foto ${i + 1}`}>
              <img
                src={src}
                alt={`Foto prewed ${i + 1}`}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
                style={`aspect-ratio: ${ratios[i]};`}
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="gallery__dialog" aria-label="Pratinjau foto">
    <button type="button" class="gallery__close" aria-label="Tutup">&times;</button>
    <img class="gallery__full" alt="" />
  </dialog>
</section>

<style>
  .gallery {
    position: relative;
    isolation: isolate;
    padding: var(--section-y) 0;
    background: #0c0b0a;
  }

  /* Latar foto dari data/wedding.ts, digelapkan agar teks tetap terbaca */
  .gallery__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--gallery-bg);
    background-size: cover;
    background-position: center;
    overflow: clip;
  }
  .gallery__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(12 11 10 / 0.744);
  }

  .gallery__grid {
    columns: 2;
    column-gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gallery__item {
    break-inside: avoid;
    margin-bottom: 6px;
  }

  .gallery__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #1c1b19;
    cursor: zoom-in;
  }

  .gallery__btn img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.4s var(--ease, ease), filter 0.4s var(--ease, ease);
  }

  .gallery__btn:hover img,
  .gallery__btn:focus-visible img {
    transform: scale(1.03);
    filter: brightness(1.08);
  }

  .gallery__btn:focus-visible {
    outline: 2px solid var(--white, #fff);
    outline-offset: 2px;
  }

  .gallery__dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100svh;
  }
  .gallery__dialog::backdrop {
    background: rgb(0 0 0 / 0.9);
  }
  .gallery__full {
    display: block;
    max-width: 92vw;
    max-height: 88svh;
    margin: auto;
    border-radius: 10px;
    object-fit: contain;
  }
  .gallery__close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.gallery__dialog');
  const full = document.querySelector<HTMLImageElement>('.gallery__full');
  const close = document.querySelector<HTMLButtonElement>('.gallery__close');

  if (dialog && full && close) {
    document.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        if (!img) return;
        full.src = img.currentSrc || img.src;
        full.alt = img.alt;
        dialog.showModal();
      });
    });

    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>