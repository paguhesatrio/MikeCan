---
import { wedding, type Person } from '../data/wedding';
import ArchWindow from './ui/ArchWindow.astro';
import SectionHead from './ui/SectionHead.astro';
import PhotoSection from './ui/PhotoSection.astro';
const people: Person[] = [wedding.bride, wedding.groom];
---

<PhotoSection id="mempelai" photo={wedding.photos.couple} shade="strong" labelledby="mempelai-title">
  <div class="container">
    <SectionHead id="mempelai-title" title="Mempelai" subtitle="Dua hati yang dipertemukan Tuhan, kini melangkah bersama." />

    <div class="couple">
      {
        people.map((p, i) => (
          <>
            <article class="person" data-reveal>
              <ArchWindow src={p.photo} alt={`Foto ${p.nickname}`} class="person__photo" />
              <p class="person__role">{p.role}</p>
              <h3 class="person__name">{p.fullName}</h3>
              <p class="person__desc">{p.description}</p>
              <p class="person__parents">
                {p.childOrder}
                <br />
                <strong>{p.father}</strong> &amp; <strong>{p.mother}</strong>
              </p>
              {p.instagram && (
                <a class="btn btn--ghost person__ig" href={`https://instagram.com/${p.instagram}`} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.3" cy="6.7" r="0.8" fill="currentColor" />
                  </svg>
                  @{p.instagram}
                </a>
              )}
            </article>
            {i === 0 && <p class="couple__amp" aria-hidden="true">&amp;</p>}
          </>
        ))
      }
    </div>
  </div>
</PhotoSection>

<style>
  .couple {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .person {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  :global(.person__photo) {
    width: min(58cqi, 13.5rem);
    margin-bottom: 1.25rem !important;
  }
  .person__role {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .person__name {
    margin-top: 0.3rem;
    font-size: clamp(1.7rem, 8cqi, 2.1rem);
  }
  .person__desc {
    margin-top: 0.6rem;
    max-width: 21rem;
    color: var(--text-soft);
  }
  .person__parents {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    color: var(--text-soft);
    line-height: 1.55;
  }
  .person__parents strong {
    font-weight: 600;
    color: var(--white);
  }
  .person__ig {
    margin-top: 1rem;
    min-height: 2.6rem;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .couple__amp {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--accent);
  }
</style>
