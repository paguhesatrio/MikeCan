---
import { wedding1 } from "../data/wedding";
import SectionHead from "./ui/SectionHead.astro";

const photos = wedding1.photos.gallery.slice(0, 8);
const background = wedding1.photos.background;

// Susunan 3 - 3 - 2: tentukan arah masuk tiap foto
// baris 1-2 : kiri = dari kiri, tengah = dari atas, kanan = dari kanan
// baris 3   : foto kiri dari kiri, foto kanan dari kanan
const dirOf = (i: number) => {
  if (i >= 6) return i === 6 ? "from-left" : "from-right"; // dua foto besar di baris terakhir
  const col = i % 3; // 0 = kiri, 1 = tengah, 2 = kanan
  if (col === 0) return "from-left";
  if (col === 2) return "from-right";
  return "from-top";
};
---

<section
  id="galeri"
  class="gallery"
  aria-labelledby="galeri-title"
  style={`--gallery-bg: url('${background}');`}
>
  <div class="gallery__bg" aria-hidden="true"></div>

  <div class="container">
    <div class="reveal-item" style="--i: 0">
      <SectionHead
        id="galeri-title"
        title="Galeri"
        subtitle="Momen kebersamaan kami."
      />
    </div>

    <!-- Susunan 3 - 3 - 2: baris 1 dan 2 berisi 3 foto, baris 3 berisi 2 foto -->
    <div class="mosaic">
      {
        photos.map((src, i) => {
          const isLastRow = i >= 6;
          return (
            <button
              type="button"
              class={`shot ${isLastRow ? "shot--half" : "shot--third"} reveal-item ${dirOf(i)}`}
              style={`--i: ${i + 1}`}
              data-shot
              aria-label={`Lihat foto ${i + 1}`}
            >
              <img
                src={src}
                alt={`Foto prewed ${i + 1}`}
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </button>
          );
        })
      }
    </div>
  </div>

  <dialog class="gallery__dialog" aria-label="Pratinjau foto">
    <button type="button" class="gallery__close" aria-label="Tutup"
      >&times;</button
    >
    <img class="gallery__full" alt="" />
  </dialog>
</section>

<style>
  .gallery {
    position: relative;
    isolation: isolate;
    padding: var(--section-y) 0;
    background: #0c0b0a;
  }

  .gallery__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--gallery-bg);
    background-size: cover;
    background-position: center;
    overflow: clip;
  }
  .gallery__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(12 11 10 / 0.744);
  }

  /* ---------- Mozaik foto: grid 6 kolom ----------
     baris 1 : 3 foto (masing-masing 2 kolom)
     baris 2 : 3 foto (masing-masing 2 kolom)
     baris 3 : 2 foto (masing-masing 3 kolom) */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    margin-top: 1.5rem;
  }

  .shot {
    position: relative;
    padding: 0;
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    background: #1a1a1a;
    cursor: pointer;
    aspect-ratio: 3 / 4;
  }
  .shot--third {
    grid-column: span 2;
  }
  .shot--half {
    grid-column: span 3;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  @media (hover: hover) {
    .shot:hover img {
      transform: scale(1.03);
    }
  }
  .shot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ---------- Efek masuk saat section terlihat (lebih lambat) ---------- */
  :global(.js) .reveal-item {
    opacity: 0;
    transition:
      opacity 1.4s ease,
      transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i, 0) * 260ms);
  }
  :global(.js) .reveal-item.from-top {
    transform: translateY(-80px);
  }
  :global(.js) .reveal-item.from-left {
    transform: translateX(-110px);
  }
  :global(.js) .reveal-item.from-right {
    transform: translateX(110px);
  }
  :global(.js) .gallery.is-visible .reveal-item {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- Pratinjau foto penuh ---------- */
  .gallery__dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100svh;
  }
  .gallery__dialog::backdrop {
    background: rgb(0 0 0 / 0.9);
  }
  .gallery__full {
    display: block;
    max-width: 92vw;
    max-height: 88svh;
    margin: auto;
    border-radius: 10px;
    object-fit: contain;
  }
  .gallery__close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  const section = document.getElementById("galeri");
  const shots = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-shot]"),
  );
  const dialog = document.querySelector<HTMLDialogElement>(".gallery__dialog");
  const full = document.querySelector<HTMLImageElement>(".gallery__full");
  const close = document.querySelector<HTMLButtonElement>(".gallery__close");

  if (section) {
    // Fade in saat section mulai terlihat, lalu observer dilepas
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          section.classList.add("is-visible");
          io.disconnect();
        }
      },
      { threshold: 0.15 },
    );
    io.observe(section);
  }

  if (dialog && full && close) {
    shots.forEach((btn) => {
      btn.addEventListener("click", () => {
        const img = btn.querySelector("img");
        if (!img) return;
        full.src = img.currentSrc || img.src;
        full.alt = img.alt;
        dialog.showModal();
      });
    });

    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>